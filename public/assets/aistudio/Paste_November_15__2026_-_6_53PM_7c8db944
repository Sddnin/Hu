<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#060b12">
<title>Húc Cổng · Đường đua từ vựng Hàn / Anh</title>
<link rel="stylesheet" href="assets/fonts/fonts.css">
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<div id="app">
  <canvas id="scene"></canvas>
  <div id="grain"></div>
  <div id="vignette"></div>
  <div id="flash"></div>

  <!-- ============================ HUD ============================ -->
  <div id="hud" class="hidden">
    <div class="hud-top">
      <div class="hud-left">
        <button id="btnPause" class="icon-btn" aria-label="Tạm dừng">
          <svg viewBox="0 0 24 24"><rect x="7" y="5" width="3.6" height="14" rx="1.2"/><rect x="14.4" y="5" width="3.6" height="14" rx="1.2"/></svg>
        </button>
        <div class="score-chip">
          <span class="chip-label">ĐÚNG</span>
          <span class="chip-value"><b id="hudScore">0</b><i>/</i><span id="hudTotal">10</span></span>
          <div class="pips" id="hudPips"></div>
        </div>
        <div class="pts-chip"><small>ĐIỂM</small><b id="hudPts">0</b></div>
        <div class="combo-chip" id="comboChip"><span id="comboVal">x2</span><small>COMBO</small></div>
      </div>

      <div class="hud-center">
        <div id="questionCard" class="q-card">
          <div class="q-tag"><span id="qDeck">KO → VI</span><em>HÚC CỔNG CÓ NGHĨA CỦA</em></div>
          <div class="q-word" id="qWord">차다</div>
          <div class="q-hint" id="qHint">tính từ · [chada]</div>
        </div>
      </div>

      <div class="hud-right">
        <button id="btnLangHud" class="lang-toggle" title="Đổi ngôn ngữ đáp án">
          <span data-l="vi">VI</span><span data-l="en">EN</span>
        </button>
        <button id="btnSound" class="icon-btn" aria-label="Bật/tắt âm thanh" data-on="1">
          <svg class="s-on" viewBox="0 0 24 24"><path d="M4 9.5h3.4L12 5.4v13.2L7.4 14.5H4z"/><path d="M15.4 8.6a4.6 4.6 0 0 1 0 6.8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M18 6.2a8 8 0 0 1 0 11.6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
          <svg class="s-off" viewBox="0 0 24 24"><path d="M4 9.5h3.4L12 5.4v13.2L7.4 14.5H4z"/><path d="M15.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="timer" id="timerBox">
          <svg viewBox="0 0 44 44" class="timer-ring"><circle cx="22" cy="22" r="19" class="ring-bg"/><circle cx="22" cy="22" r="19" class="ring-fg" id="ringFg"/></svg>
          <span id="hudTime">40</span><small>s</small>
        </div>
      </div>
    </div>

    <div class="hud-bottom">
      <div class="steer-zone left" id="zoneLeft"><div class="steer-arrow">◀</div><span>RẼ TRÁI</span></div>
      <div class="steer-zone right" id="zoneRight"><div class="steer-arrow">▶</div><span>RẼ PHẢI</span></div>

      <button id="btnDrift" class="skill drift">
        <svg viewBox="0 0 24 24" class="sk-ico"><path d="M3 17c5 0 6-9 11-9 3 0 4 2 4 4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M15.5 5.5L19 8l-3.5 2.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="5" cy="19.5" r="1.4"/><circle cx="9" cy="19.5" r="1.4"/></svg>
        <b>DRIFT</b><i class="cd" id="driftCd"></i>
      </button>

      <div class="nitro-wrap">
        <div class="nitro-bar"><i id="nitroFill"></i></div>
        <button id="btnNitro" class="skill nitro">
          <svg viewBox="0 0 24 24" class="sk-ico"><path d="M13.5 2L5 13.2h5.2L9.4 22 19 10.4h-5.4z"/></svg>
          <b>NITRO</b>
        </button>
      </div>
    </div>

    <div id="toasts"></div>
    <div id="countdown" class="hidden"><span>3</span></div>
    <div id="bannerWrap"><div id="banner"></div></div>
    <div id="gateHint" class="gate-hint"><span id="gateHintText"></span></div>
  </div>

  <!-- =========================== START =========================== -->
  <section id="screenStart" class="screen">
    <div class="start-grid">
      <div class="brand-col">
        <div class="eyebrow"><span class="dot"></span> OPENQUIZ · MINI GAME 3D</div>
        <h1 class="title">HÚC<span>CỔNG</span></h1>
        <p class="tagline">Lái xe tăng <b>390</b> húc đổ cổng mang nghĩa đúng của từ vựng.<br>Đúng: cộng giây, nối combo. Sai: nổ rào chắn, trừ giây.</p>

        <div class="setup">
          <div class="setup-row">
            <label class="setup-label">BỘ TỪ VỰNG</label>
            <div class="seg" id="deckRow">
              <button class="seg-btn active" data-deck="korean"><b>한국어</b><small>Tiếng Hàn · 40 từ</small></button>
              <button class="seg-btn" data-deck="english"><b>English</b><small>Anh–Việt · 60 từ</small></button>
            </div>
          </div>
          <div class="setup-row">
            <label class="setup-label">NGÔN NGỮ ĐÁP ÁN TRÊN CỔNG</label>
            <div class="seg small-seg" id="langRow">
              <button class="seg-btn active" data-lang="vi"><b>Tiếng Việt</b><small>VI</small></button>
              <button class="seg-btn" data-lang="en"><b>English</b><small>EN</small></button>
            </div>
          </div>
          <div class="setup-row">
            <label class="setup-label">ĐỘ KHÓ</label>
            <div class="mode-row" id="diffRow">
              <button class="mode" data-diff="easy"><b>TÂN BINH</b><small>45s · 8 cổng</small></button>
              <button class="mode active" data-diff="normal"><b>CHIẾN SĨ</b><small>40s · 10 cổng</small></button>
              <button class="mode" data-diff="hard"><b>ĐẶC CÔNG</b><small>32s · 12 cổng</small></button>
            </div>
          </div>
        </div>

        <button id="btnPlay" class="cta">
          <span>VÀO ĐƯỜNG ĐUA</span>
          <svg viewBox="0 0 24 24"><path d="M5 12h13m-5-6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="best-row">
          <div class="best"><small>KỶ LỤC</small><b id="bestScore">0</b></div>
          <div class="best"><small>COMBO MAX</small><b id="bestCombo">0</b></div>
          <div class="best"><small>LƯỢT CHƠI</small><b id="playCount">0</b></div>
        </div>
      </div>

      <aside class="howto">
        <h3>CÁCH CHƠI</h3>
        <ul>
          <li><kbd>◀</kbd><kbd>▶</kbd><span>Giữ nửa trái / phải màn hình để đánh lái. Bàn phím <kbd>A</kbd><kbd>D</kbd> hoặc <kbd>←</kbd><kbd>→</kbd>.</span></li>
          <li><kbd class="k-drift">DRIFT</kbd><span>Ôm cua sát lề đỏ–trắng để tích <b>Nitro</b>. Phím <kbd>Shift</kbd>.</span></li>
          <li><kbd class="k-nitro">NITRO</kbd><span>Bứt tốc; húc cổng lúc đang nitro được <b>+60 điểm</b>. Phím <kbd>Space</kbd>.</span></li>
          <li><kbd class="k-gate">+6s</kbd><span>Húc đúng: cộng điểm + giây + combo. Sai: <b>−5s</b>, mất combo.</span></li>
          <li><kbd class="k-cry">◆</kbd><span>Nhặt tinh thể xanh: <b>+Nitro, +1s, +25 điểm</b>.</span></li>
        </ul>
        <div class="word-preview" id="wordPreview">
          <span class="wp-k" id="wpK">차다</span>
          <span class="wp-arrow">→</span>
          <span class="wp-v" id="wpV">lạnh lẽo</span>
        </div>
        <p class="preview-note" id="previewNote">Đổi bộ từ &amp; ngôn ngữ bất cứ lúc nào — bảng cổng đổi ngay.</p>
      </aside>
    </div>
  </section>

  <!-- =========================== PAUSE =========================== -->
  <section id="screenPause" class="screen hidden">
    <div class="panel small">
      <h2>TẠM DỪNG</h2>
      <p class="muted">Đường đua đang chờ bạn.</p>
      <div class="pause-setup">
        <label class="setup-label">NGÔN NGỮ ĐÁP ÁN</label>
        <div class="seg small-seg" id="langRowPause">
          <button class="seg-btn active" data-lang="vi"><b>Tiếng Việt</b><small>VI</small></button>
          <button class="seg-btn" data-lang="en"><b>English</b><small>EN</small></button>
        </div>
      </div>
      <div class="panel-actions">
        <button id="btnResume" class="cta"><span>TIẾP TỤC</span></button>
        <button id="btnRestartP" class="btn-2">CHƠI LẠI</button>
        <button id="btnHomeP" class="btn-2">VỀ MENU</button>
      </div>
    </div>
  </section>

  <!-- ========================== RESULT ========================== -->
  <section id="screenResult" class="screen hidden">
    <div class="panel result">
      <div class="res-head">
        <div class="rank-badge" id="rankBadge">S</div>
        <div>
          <div class="res-kicker" id="resKicker">HOÀN THÀNH ĐƯỜNG ĐUA</div>
          <h2 id="resTitle">XUẤT SẮC!</h2>
          <div class="res-meta" id="resMeta"></div>
        </div>
      </div>
      <div class="res-stats">
        <div class="stat big"><small>TỔNG ĐIỂM</small><b id="resScore">0</b></div>
        <div class="stat"><small>ĐÚNG</small><b id="resCorrect">0/10</b></div>
        <div class="stat"><small>COMBO MAX</small><b id="resCombo">0</b></div>
        <div class="stat"><small>GIÂY CÒN LẠI</small><b id="resTime">0s</b></div>
      </div>
      <div class="review-head">
        <h3>XEM LẠI TỪ VỰNG</h3>
        <div class="rev-tools">
          <span id="reviewNote" class="muted"></span>
          <button id="btnFilterMiss" class="mini-btn" data-only="0">CHỈ TỪ SAI</button>
        </div>
      </div>
      <div class="review" id="reviewList"></div>
      <div class="panel-actions">
        <button id="btnAgain" class="cta"><span>CHƠI LẠI</span>
          <svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v4.5h-4.5" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button id="btnSwapLang" class="btn-2">ĐỔI SANG <span id="swapTarget">ENGLISH</span></button>
        <button id="btnHomeR" class="btn-2">VỀ MENU</button>
      </div>
    </div>
  </section>

  <div id="rotateHint"><div class="rh-inner">
    <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 3.5l2 2-2 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <b>Xoay ngang máy để đua đã hơn</b><span>Vẫn chơi được ở khổ dọc nhé.</span>
  </div></div>

  <div id="fatal" class="hidden"><div class="panel small">
    <h2>Không tải được đồ hoạ 3D</h2>
    <p class="muted">Trình duyệt chưa bật WebGL. Hãy thử Chrome / Safari mới nhất hoặc bật tăng tốc phần cứng.</p>
  </div></div>
</div>

<script src="vendor/three.min.js"></script>
<script src="js/words.js"></script>
<script src="js/audio.js"></script>
<script src="js/game.js"></script>
</body>
</html>

Css/style.css
/* HÚC CỔNG — olive quân đội · cờ đỏ sao vàng · neon đường đua */
:root{
  --ink:#060b12; --ink-2:#0c1522; --ink-3:#132132;
  --olive:#4f7a2e; --olive-lt:#8fc44a; --acid:#c6ff3d;
  --red:#e8232f; --gold:#ffc21f; --blue:#2f7dff; --cyan:#39e0ff; --magenta:#ff3ea5;
  --cream:#f4efe2; --muted:#9fb0bf;
  --ok:#3ddc84; --warn:#ffb020; --danger:#ff3b46; --info:#39e0ff;
  --shadow:0 18px 50px rgba(0,0,0,.55);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0;background:var(--ink);color:var(--cream);
  font-family:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',sans-serif;overflow:hidden;overscroll-behavior:none}
body{user-select:none;-webkit-user-select:none;touch-action:none}
#app{position:fixed;inset:0;overflow:hidden}
canvas#scene{position:absolute;inset:0;width:100%;height:100%;display:block}
.hidden{display:none !important}

*::-webkit-scrollbar{width:10px;height:10px}
*::-webkit-scrollbar-track{background:rgba(143,196,74,.07);border-radius:20px}
*::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--olive-lt),var(--olive));border-radius:20px;border:2px solid var(--ink-2)}
*::-webkit-scrollbar-thumb:hover{background:linear-gradient(180deg,var(--acid),var(--olive-lt))}
*{scrollbar-width:thin;scrollbar-color:var(--olive) rgba(143,196,74,.09)}

#grain{position:absolute;inset:-50%;pointer-events:none;opacity:.05;z-index:2;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='.55'/></svg>");
  animation:grainShift 1.1s steps(3) infinite}
@keyframes grainShift{0%{transform:translate(0,0)}33%{transform:translate(-2%,1%)}66%{transform:translate(1%,-2%)}100%{transform:translate(0,0)}}
#vignette{position:absolute;inset:0;pointer-events:none;z-index:3;
  background:radial-gradient(125% 92% at 50% 44%,transparent 44%,rgba(3,7,12,.6) 100%)}
#flash{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .18s ease;z-index:4}
#flash.good{background:radial-gradient(92% 72% at 50% 62%,rgba(61,220,132,.32),transparent 70%);opacity:1}
#flash.bad{background:linear-gradient(180deg,rgba(232,35,47,.45),rgba(232,35,47,.14));opacity:1}
#flash.nitro{background:radial-gradient(82% 62% at 50% 72%,rgba(57,224,255,.26),transparent 72%);opacity:1}

/* ---------------- HUD ---------------- */
#hud{position:absolute;inset:0;pointer-events:none;z-index:6}
.hud-top{position:absolute;top:0;left:0;right:0;display:flex;align-items:flex-start;justify-content:space-between;
  gap:10px;padding:calc(10px + env(safe-area-inset-top)) 14px 0}
.hud-left,.hud-right{display:flex;align-items:center;gap:9px;pointer-events:auto}
.hud-center{flex:1;display:flex;justify-content:center;min-width:0}
.icon-btn{width:42px;height:42px;border-radius:13px;border:1.5px solid rgba(143,196,74,.28);
  background:linear-gradient(160deg,rgba(19,33,50,.94),rgba(6,11,18,.94));color:var(--cream);
  display:grid;place-items:center;cursor:pointer;backdrop-filter:blur(8px);transition:.16s;flex:none}
.icon-btn svg{width:22px;height:22px;fill:currentColor}
.icon-btn:hover{border-color:var(--acid);color:var(--acid);transform:translateY(-1px)}
.icon-btn:active{transform:scale(.94)}
#btnSound .s-off{display:none}
#btnSound[data-on="0"] .s-on{display:none}
#btnSound[data-on="0"] .s-off{display:block}
#btnSound[data-on="0"]{color:var(--muted);border-color:rgba(255,255,255,.14)}
.lang-toggle{display:flex;padding:3px;gap:2px;border-radius:12px;cursor:pointer;font-family:inherit;
  background:linear-gradient(160deg,rgba(19,33,50,.94),rgba(6,11,18,.94));border:1.5px solid rgba(57,224,255,.35);
  backdrop-filter:blur(8px);transition:.16s}
.lang-toggle span{padding:5px 9px;border-radius:9px;font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--muted);transition:.18s}
.lang-toggle span.on{background:linear-gradient(150deg,var(--cyan),var(--blue));color:#04121f;box-shadow:0 0 14px rgba(57,224,255,.55)}
.lang-toggle:hover{border-color:var(--cyan);transform:translateY(-1px)}
.score-chip,.pts-chip{display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:14px;
  background:linear-gradient(150deg,rgba(19,33,50,.94),rgba(6,11,18,.9));border:1.5px solid rgba(143,196,74,.35);
  box-shadow:0 8px 24px rgba(0,0,0,.4);backdrop-filter:blur(8px)}
.chip-label{font-size:10px;letter-spacing:.16em;color:var(--olive-lt);font-weight:800}
.chip-value{font-weight:800;font-size:19px;line-height:1;display:flex;align-items:baseline;gap:2px}
.chip-value i{color:var(--muted);font-style:normal;font-size:13px;margin:0 1px}
.chip-value span{color:var(--muted);font-size:13px}
.pips{display:flex;gap:3px;margin-left:2px}
.pips i{width:6px;height:14px;border-radius:3px;background:rgba(255,255,255,.14);display:block;transition:.25s}
.pips i.on{background:linear-gradient(180deg,var(--acid),var(--olive-lt));box-shadow:0 0 8px rgba(198,255,61,.6)}
.pips i.miss{background:var(--danger);opacity:.8}
.pts-chip{flex-direction:column;gap:0;padding:5px 12px;border-color:rgba(255,194,31,.35)}
.pts-chip small{font-size:8.5px;letter-spacing:.16em;color:var(--gold);font-weight:800}
.pts-chip b{font-size:17px;line-height:1.15;font-variant-numeric:tabular-nums}
.combo-chip{display:none;flex-direction:column;align-items:center;padding:5px 11px;border-radius:13px;
  background:linear-gradient(150deg,#ff8a00,var(--red));border:1.5px solid var(--gold);color:#fff;
  box-shadow:0 0 22px rgba(255,138,0,.45);animation:pop .3s ease}
.combo-chip.show{display:flex}
.combo-chip.hot{background:linear-gradient(150deg,var(--magenta),#a3006b);border-color:#ffc9e8;box-shadow:0 0 26px rgba(255,62,165,.6)}
.combo-chip span{font-weight:800;font-size:17px;line-height:1}
.combo-chip small{font-size:8px;letter-spacing:.14em;font-weight:800;opacity:.92}
@keyframes pop{0%{transform:scale(.5);opacity:0}60%{transform:scale(1.14)}100%{transform:scale(1)}}
.q-card{pointer-events:none;text-align:center;padding:8px 22px 10px;border-radius:16px;max-width:min(48vw,440px);
  background:linear-gradient(165deg,rgba(12,21,34,.94),rgba(6,11,18,.88));
  border:1.5px solid rgba(255,194,31,.45);box-shadow:0 14px 40px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.07);
  backdrop-filter:blur(10px);opacity:0;transform:translateY(-14px) scale(.96);transition:.28s cubic-bezier(.2,.9,.3,1.3)}
.q-card.show{opacity:1;transform:none}
.q-tag{display:flex;align-items:center;justify-content:center;gap:7px;font-size:9.5px;letter-spacing:.16em;font-weight:800}
.q-tag span{color:#04121f;background:linear-gradient(150deg,var(--cyan),var(--blue));padding:2px 7px;border-radius:6px;letter-spacing:.08em}
.q-tag em{color:var(--gold);font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.q-word{font-family:'Black Han Sans','Be Vietnam Pro',sans-serif;font-size:clamp(24px,4.4vh,42px);line-height:1.14;
  margin-top:3px;color:#fff;text-shadow:0 0 26px rgba(255,194,31,.45);word-break:break-word}
.q-word.latin{font-family:'Be Vietnam Pro',sans-serif;font-weight:800;letter-spacing:-.01em;font-size:clamp(19px,3.5vh,32px)}
.q-hint{font-size:11px;color:var(--muted);margin-top:1px}
.q-card.correct{border-color:var(--ok);box-shadow:0 0 40px rgba(61,220,132,.45)}
.q-card.wrong{border-color:var(--danger);box-shadow:0 0 40px rgba(255,59,70,.45);animation:shake .34s}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-9px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(4px)}}
.timer{position:relative;width:56px;height:56px;display:grid;place-items:center;flex:none}
.timer-ring{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
.timer-ring circle{fill:none;stroke-width:4;stroke-linecap:round}
.ring-bg{stroke:rgba(255,255,255,.13)}
.ring-fg{stroke:var(--acid);stroke-dasharray:119.4;stroke-dashoffset:0;transition:stroke .3s}
.timer span{font-weight:800;font-size:20px;line-height:1;z-index:1;font-variant-numeric:tabular-nums}
.timer small{position:absolute;bottom:8px;font-size:9px;color:var(--muted);z-index:1}
.timer.low .ring-fg{stroke:var(--danger)}
.timer.low span{color:var(--danger);animation:tick .9s infinite}
@keyframes tick{0%,100%{transform:scale(1)}50%{transform:scale(1.16)}}
.gate-hint{position:absolute;left:50%;top:calc(98px + env(safe-area-inset-top));transform:translateX(-50%);
  font-size:10px;font-weight:800;letter-spacing:.16em;color:rgba(244,239,226,.55);opacity:0;transition:.25s;white-space:nowrap}
.gate-hint.show{opacity:1}
.hud-bottom{position:absolute;left:0;right:0;bottom:0;height:100%;pointer-events:none}
.steer-zone{position:absolute;bottom:0;top:28%;width:38%;pointer-events:auto;display:flex;flex-direction:column;
  align-items:center;justify-content:flex-end;padding-bottom:calc(14px + env(safe-area-inset-bottom));gap:2px;
  color:rgba(244,239,226,.34);font-size:10px;letter-spacing:.18em;font-weight:800;transition:.15s}
.steer-zone.left{left:0;background:linear-gradient(90deg,rgba(143,196,74,.10),transparent 70%)}
.steer-zone.right{right:0;background:linear-gradient(270deg,rgba(143,196,74,.10),transparent 70%)}
.steer-arrow{font-size:26px;line-height:1;opacity:.5;transition:.15s}
.steer-zone.active{color:var(--acid)}
.steer-zone.active .steer-arrow{opacity:1;transform:scale(1.25);text-shadow:0 0 18px rgba(198,255,61,.8)}
.steer-zone.left.active{background:linear-gradient(90deg,rgba(198,255,61,.20),transparent 72%)}
.steer-zone.right.active{background:linear-gradient(270deg,rgba(198,255,61,.20),transparent 72%)}
.skill{position:absolute;bottom:calc(18px + env(safe-area-inset-bottom));width:88px;height:88px;border-radius:50%;
  pointer-events:auto;border:2.5px solid;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
  cursor:pointer;color:#08121b;font-family:inherit;overflow:hidden;transition:transform .12s,box-shadow .2s,filter .2s}
.skill b{font-size:12px;font-weight:800;letter-spacing:.08em}
.sk-ico{width:26px;height:26px;fill:currentColor}
.skill:active{transform:scale(.92)}
.skill.drift{left:calc(20px + env(safe-area-inset-left));background:radial-gradient(circle at 34% 28%,#ffe27a,var(--gold) 62%,#e08a00);
  border-color:#fff3c4;box-shadow:0 10px 30px rgba(255,194,31,.35),inset 0 -6px 14px rgba(0,0,0,.18)}
.skill.drift.on{filter:brightness(1.2);box-shadow:0 0 34px rgba(255,194,31,.85)}
.skill.drift.cooling{filter:grayscale(.7) brightness(.62);cursor:not-allowed}
.skill .cd{position:absolute;left:0;bottom:0;width:100%;background:rgba(6,11,18,.62);height:0%;pointer-events:none}
.nitro-wrap{position:absolute;right:calc(20px + env(safe-area-inset-right));bottom:calc(18px + env(safe-area-inset-bottom));
  pointer-events:auto;display:flex;flex-direction:column;align-items:center;gap:7px}
.nitro-bar{width:88px;height:8px;border-radius:6px;background:rgba(6,11,18,.75);border:1.5px solid rgba(57,224,255,.35);overflow:hidden}
.nitro-bar i{display:block;height:100%;width:0%;border-radius:4px;background:linear-gradient(90deg,var(--blue),var(--cyan));
  box-shadow:0 0 12px rgba(57,224,255,.8);transition:width .12s linear}
.skill.nitro{position:static;background:radial-gradient(circle at 34% 28%,#9fd0ff,var(--blue) 60%,#1246b8);
  border-color:#cfe6ff;color:#04121f;box-shadow:0 10px 30px rgba(47,125,255,.4),inset 0 -6px 14px rgba(0,0,0,.2)}
.skill.nitro.ready{animation:nitroPulse 1.5s infinite}
.skill.nitro.empty{filter:grayscale(.8) brightness(.55);cursor:not-allowed}
.skill.nitro.on{filter:brightness(1.25);box-shadow:0 0 40px rgba(57,224,255,.9)}
@keyframes nitroPulse{0%,100%{box-shadow:0 10px 30px rgba(47,125,255,.4)}50%{box-shadow:0 0 34px rgba(57,224,255,.85)}}
#toasts{position:absolute;left:50%;top:40%;transform:translateX(-50%);display:flex;flex-direction:column;
  align-items:center;gap:6px;pointer-events:none;width:max-content;max-width:88vw}
.toast{font-weight:800;font-size:clamp(20px,3.4vh,32px);text-shadow:0 4px 18px rgba(0,0,0,.75);text-align:center;
  animation:toastUp 1.2s cubic-bezier(.2,.8,.3,1) forwards}
.toast.good{color:var(--ok)}.toast.bad{color:var(--danger)}.toast.gold{color:var(--gold)}.toast.cyan{color:var(--cyan)}
.toast small{display:block;font-size:12px;font-weight:600;letter-spacing:.08em;color:var(--cream);opacity:.88}
@keyframes toastUp{0%{opacity:0;transform:translateY(18px) scale(.8)}18%{opacity:1;transform:translateY(0) scale(1.08)}
  30%{transform:scale(1)}75%{opacity:1;transform:translateY(-16px)}100%{opacity:0;transform:translateY(-42px)}}
#countdown{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;background:rgba(4,8,14,.35)}
#countdown span{font-family:'Black Han Sans',sans-serif;font-size:clamp(58px,18vh,150px);color:#fff;
  text-shadow:0 0 60px rgba(198,255,61,.75),0 10px 30px rgba(0,0,0,.6);animation:cd .85s ease-out}
@keyframes cd{0%{transform:scale(2.1);opacity:0}25%{transform:scale(1);opacity:1}80%{opacity:1}100%{transform:scale(.82);opacity:0}}
#bannerWrap{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none}
#banner{opacity:0;transform:scaleY(.2);padding:14px 18px;width:min(80vw,580px);text-align:center;border-radius:14px;
  background:linear-gradient(180deg,#ff4a52,var(--red));border:2px solid #ffb3b7;color:#fff;font-weight:800;
  box-shadow:0 0 60px rgba(232,35,47,.7);transition:.2s}
#banner.show{opacity:1;transform:scaleY(1)}
#banner .bw{font-family:'Black Han Sans',sans-serif;font-size:clamp(19px,3.4vh,28px);display:block;line-height:1.15}
#banner .bw.latin{font-family:'Be Vietnam Pro',sans-serif;font-weight:800}
#banner .bt{font-size:14px;letter-spacing:.04em}
#banner.ok{background:linear-gradient(180deg,#57e79a,#17a75d);border-color:#c9ffe3;box-shadow:0 0 60px rgba(61,220,132,.6)}

/* ---------------- SCREENS ---------------- */
.screen{position:absolute;inset:0;z-index:20;display:grid;place-items:center;padding:18px;
  background:radial-gradient(120% 100% at 16% 10%,rgba(79,122,46,.34),transparent 55%),
             radial-gradient(95% 95% at 88% 90%,rgba(47,125,255,.26),transparent 60%),
             radial-gradient(60% 60% at 70% 20%,rgba(255,62,165,.12),transparent 65%),
             linear-gradient(160deg,rgba(4,8,14,.93),rgba(4,8,14,.97));
  backdrop-filter:blur(7px);overflow:auto;animation:fadeIn .3s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.screen::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.32;
  background-image:repeating-linear-gradient(115deg,rgba(255,255,255,.045) 0 2px,transparent 2px 9px)}
.start-grid{position:relative;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:26px;
  width:min(1100px,100%);align-items:center;margin:auto}
.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:10.5px;letter-spacing:.24em;font-weight:800;color:var(--olive-lt)}
.eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 12px var(--red);animation:blink 1.6s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
.title{font-family:'Black Han Sans',sans-serif;font-size:clamp(44px,9.6vh,96px);line-height:.92;margin:8px 0 6px;color:var(--cream);
  text-shadow:0 12px 40px rgba(0,0,0,.6)}
.title span{display:block;color:transparent;-webkit-text-stroke:2.5px var(--gold);text-shadow:0 0 42px rgba(255,194,31,.35)}
.tagline{color:#cbd8e2;font-size:clamp(12.5px,1.85vh,15px);line-height:1.6;max-width:48ch;margin:0 0 14px}
.tagline b{color:var(--acid)}
.setup{display:flex;flex-direction:column;gap:11px;margin-bottom:16px}
.setup-row{display:flex;flex-direction:column;gap:6px}
.setup-label{font-size:9px;letter-spacing:.2em;font-weight:800;color:var(--muted)}
.seg{display:flex;gap:8px;flex-wrap:wrap}
.seg-btn{flex:1 1 140px;min-width:130px;text-align:left;padding:9px 13px;border-radius:13px;cursor:pointer;font-family:inherit;
  background:linear-gradient(160deg,rgba(19,33,50,.9),rgba(8,14,22,.9));border:1.6px solid rgba(255,255,255,.13);
  color:var(--cream);transition:.18s;display:flex;align-items:baseline;gap:8px}
.seg-btn b{font-size:14px}
.seg-btn small{font-size:10px;color:var(--muted)}
.seg-btn:hover{border-color:rgba(57,224,255,.55);transform:translateY(-2px)}
.seg-btn.active{border-color:var(--cyan);background:linear-gradient(160deg,rgba(47,125,255,.42),rgba(19,33,50,.95));
  box-shadow:0 0 24px rgba(57,224,255,.25)}
.seg-btn.active small{color:#d6ecff}
.small-seg .seg-btn{flex:0 1 auto;min-width:112px;padding:7px 12px}
.small-seg .seg-btn b{font-size:12.5px}
.mode-row{display:flex;gap:8px;flex-wrap:wrap}
.mode{flex:1 1 120px;min-width:112px;text-align:left;padding:9px 12px;border-radius:13px;cursor:pointer;font-family:inherit;
  background:linear-gradient(160deg,rgba(19,33,50,.9),rgba(8,14,22,.9));border:1.6px solid rgba(255,255,255,.13);
  color:var(--cream);transition:.18s}
.mode b{display:block;font-size:12.5px;letter-spacing:.06em}
.mode small{display:block;font-size:10px;color:var(--muted);margin-top:2px}
.mode:hover{border-color:rgba(198,255,61,.55);transform:translateY(-2px)}
.mode.active{border-color:var(--acid);background:linear-gradient(160deg,rgba(79,122,46,.55),rgba(19,33,50,.95));
  box-shadow:0 0 24px rgba(198,255,61,.22)}
.mode.active small{color:#dbe9c6}
.cta{display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:15px 30px;border-radius:16px;border:none;cursor:pointer;
  font-family:inherit;font-weight:800;font-size:16px;letter-spacing:.08em;color:#0a1408;
  background:linear-gradient(120deg,var(--acid),var(--olive-lt) 55%,#5fae2f);
  box-shadow:0 14px 34px rgba(143,196,74,.35),inset 0 -4px 10px rgba(0,0,0,.16);transition:.16s;position:relative;overflow:hidden}
.cta svg{width:22px;height:22px;fill:none}
.cta:hover{transform:translateY(-2px);box-shadow:0 18px 44px rgba(198,255,61,.45)}
.cta:active{transform:translateY(1px) scale(.99)}
.cta::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;transform:skewX(-22deg);
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);animation:sheen 3.4s infinite}
@keyframes sheen{0%{left:-60%}55%{left:130%}100%{left:130%}}
.best-row{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
.best{padding:8px 14px;border-radius:12px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.1)}
.best small{display:block;font-size:9px;letter-spacing:.16em;color:var(--muted);font-weight:800}
.best b{font-size:19px;color:var(--gold);font-variant-numeric:tabular-nums}
.howto{background:linear-gradient(165deg,rgba(19,33,50,.92),rgba(6,11,18,.92));border:1.5px solid rgba(255,255,255,.12);
  border-radius:22px;padding:20px 20px 16px;box-shadow:var(--shadow)}
.howto h3{margin:0 0 12px;font-size:12px;letter-spacing:.2em;color:var(--gold)}
.howto ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
.howto li{display:flex;gap:9px;align-items:flex-start;font-size:12.2px;line-height:1.5;color:#c9d6e0}
.howto li span{flex:1}
kbd{display:inline-grid;place-items:center;min-width:26px;height:24px;padding:0 7px;border-radius:8px;font-family:inherit;
  font-size:10.5px;font-weight:800;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);color:var(--cream);flex:none}
kbd.k-drift{background:linear-gradient(160deg,#ffe27a,var(--gold));color:#3a2600;border-color:#fff0b8}
kbd.k-nitro{background:linear-gradient(160deg,#9fd0ff,var(--blue));color:#04121f;border-color:#cfe6ff}
kbd.k-gate{background:linear-gradient(160deg,#7ef0b0,#17a75d);color:#04220f;border-color:#c9ffe3}
kbd.k-cry{background:linear-gradient(160deg,#a9f2ff,var(--cyan));color:#04222b;border-color:#d6f8ff}
.word-preview{margin-top:15px;padding:12px;border-radius:14px;display:flex;align-items:center;justify-content:center;gap:12px;
  background:linear-gradient(120deg,rgba(79,122,46,.35),rgba(47,125,255,.22));border:1px dashed rgba(255,194,31,.45);min-height:58px}
.wp-k{font-family:'Black Han Sans',sans-serif;font-size:26px;color:#fff;text-align:center}
.wp-k.latin{font-family:'Be Vietnam Pro',sans-serif;font-weight:800;font-size:18px}
.wp-arrow{color:var(--gold);font-weight:800}
.wp-v{font-weight:800;color:var(--acid);font-size:15px;text-align:center}
.preview-note{margin:9px 0 0;font-size:10.5px;color:var(--muted);text-align:center;line-height:1.5}
.panel{position:relative;width:min(780px,100%);background:linear-gradient(165deg,rgba(19,33,50,.96),rgba(6,11,18,.97));
  border:1.6px solid rgba(255,255,255,.14);border-radius:24px;padding:24px;box-shadow:var(--shadow);
  animation:panelIn .34s cubic-bezier(.2,.9,.3,1.2);margin:auto}
@keyframes panelIn{from{opacity:0;transform:translateY(22px) scale(.97)}to{opacity:1;transform:none}}
.panel.small{width:min(430px,100%);text-align:center}
.panel h2{font-family:'Black Han Sans',sans-serif;font-size:clamp(26px,4.6vh,40px);margin:4px 0 6px}
.muted{color:var(--muted);font-size:12.5px}
.pause-setup{margin-top:16px;display:flex;flex-direction:column;gap:7px;align-items:center}
.panel-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.panel.small .panel-actions{flex-direction:column}
.btn-2{flex:1;min-width:120px;padding:13px 16px;border-radius:14px;cursor:pointer;font-family:inherit;font-weight:800;font-size:12.5px;
  letter-spacing:.06em;color:var(--cream);background:rgba(255,255,255,.06);border:1.5px solid rgba(255,255,255,.18);transition:.16s}
.btn-2:hover{border-color:var(--acid);color:var(--acid);transform:translateY(-2px)}
.btn-2 span{color:var(--cyan)}
.panel-actions .cta{flex:2;min-width:180px}
.res-head{display:flex;align-items:center;gap:16px;margin-bottom:16px}
.rank-badge{width:74px;height:74px;border-radius:20px;display:grid;place-items:center;font-family:'Black Han Sans',sans-serif;
  font-size:40px;color:#0a1408;background:linear-gradient(150deg,var(--gold),#ff8a00);border:2px solid #fff0b8;
  box-shadow:0 0 34px rgba(255,194,31,.45);flex:none}
.rank-badge.a{background:linear-gradient(150deg,var(--acid),var(--olive-lt));border-color:#eaffc0}
.rank-badge.b{background:linear-gradient(150deg,#9fd0ff,var(--blue));border-color:#cfe6ff;color:#04121f}
.rank-badge.c{background:linear-gradient(150deg,#8fa3b3,#4a5c6b);border-color:#cbd8e2;color:#0a1408}
.res-kicker{font-size:10px;letter-spacing:.2em;color:var(--gold);font-weight:800}
.res-meta{font-size:11px;color:var(--muted);margin-top:2px}
.res-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.stat{padding:11px 12px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1)}
.stat small{display:block;font-size:9px;letter-spacing:.14em;color:var(--muted);font-weight:800;margin-bottom:3px}
.stat b{font-size:20px;font-variant-numeric:tabular-nums}
.stat.big{background:linear-gradient(150deg,rgba(79,122,46,.5),rgba(47,125,255,.2));border-color:rgba(198,255,61,.4)}
.stat.big b{font-size:30px;color:var(--acid)}
.review-head{display:flex;align-items:center;justify-content:space-between;margin:18px 0 8px;gap:10px;flex-wrap:wrap}
.review-head h3{margin:0;font-size:11px;letter-spacing:.2em;color:var(--gold)}
.rev-tools{display:flex;align-items:center;gap:10px}
.mini-btn{padding:6px 11px;border-radius:9px;cursor:pointer;font-family:inherit;font-size:10px;font-weight:800;letter-spacing:.1em;
  color:var(--muted);background:rgba(255,255,255,.05);border:1.4px solid rgba(255,255,255,.16);transition:.16s}
.mini-btn:hover{color:var(--cream);border-color:var(--danger)}
.mini-btn.on{color:#fff;background:linear-gradient(150deg,#ff4a52,var(--red));border-color:#ffb3b7}
.review{max-height:min(30vh,250px);overflow-y:auto;display:flex;flex-direction:column;gap:7px;padding-right:6px}
.rev{display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:12px;background:rgba(255,255,255,.045);border-left:4px solid var(--ok)}
.rev.miss{border-left-color:var(--danger);background:rgba(255,59,70,.09)}
.rev .rk{font-family:'Black Han Sans',sans-serif;font-size:19px;min-width:96px;color:#fff;word-break:break-word}
.rev .rk.latin{font-family:'Be Vietnam Pro',sans-serif;font-weight:800;font-size:14px}
.rev .rv{flex:1;font-size:13px;font-weight:600}
.rev .rv em{display:block;font-style:normal;font-size:11px;color:var(--muted);font-weight:500}
.rev .rx{font-size:11px;color:var(--muted);text-align:right;max-width:34%}
.rev .ri{font-size:15px;font-weight:800}
.rev.ok .ri{color:var(--ok)}.rev.miss .ri{color:var(--danger)}
.rev-empty{padding:14px;text-align:center;color:var(--muted);font-size:12.5px}
#rotateHint{position:absolute;left:50%;bottom:calc(122px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:30;pointer-events:none;display:none}
.rh-inner{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 16px;border-radius:14px;text-align:center;
  background:rgba(6,11,18,.9);border:1.5px solid rgba(255,194,31,.5);box-shadow:var(--shadow);animation:fadeIn .4s}
.rh-inner svg{width:26px;height:26px;color:var(--gold)}
.rh-inner b{font-size:12px}.rh-inner span{font-size:10px;color:var(--muted)}
#fatal{position:absolute;inset:0;z-index:60;display:grid;place-items:center;background:var(--ink);padding:20px}

@media (max-aspect-ratio:1/1){
  .start-grid{grid-template-columns:1fr;gap:16px;padding:6px 0}
  .howto{order:2}
  .title{font-size:clamp(42px,8.4vh,70px)}
  .q-card{max-width:56vw;padding:6px 12px 8px}
  .q-tag em{display:none}
  .hud-top{padding-left:10px;padding-right:10px;gap:6px}
  .score-chip{padding:6px 9px;gap:6px}
  .chip-label,.pips{display:none}
  .pts-chip{padding:4px 9px}
  .pts-chip b{font-size:15px}
  .skill{width:74px;height:74px}
  .nitro-bar{width:74px}
  .res-stats{grid-template-columns:repeat(2,1fr)}
  .steer-zone{width:44%;top:34%}
  .combo-chip{padding:4px 8px}
  .combo-chip span{font-size:14px}
  .lang-toggle span{padding:4px 7px;font-size:10px}
  .rev .rx{display:none}
}
@media (orientation:portrait) and (max-width:820px){ #rotateHint.play{display:block} }
@media (max-height:460px){
  .title{font-size:clamp(30px,11vh,54px)}
  .tagline{margin-bottom:9px;font-size:11.5px}
  .setup{gap:8px;margin-bottom:11px}
  .howto{padding:14px}.howto li{font-size:11px}
  .best-row{margin-top:10px}
  .panel{padding:16px}
  .review{max-height:24vh}
  .skill{width:70px;height:70px;bottom:calc(12px + env(safe-area-inset-bottom))}
  .nitro-wrap{bottom:calc(12px + env(safe-area-inset-bottom))}
  .nitro-bar{width:70px}
  .timer{width:48px;height:48px}.timer span{font-size:17px}
  .word-preview{margin-top:10px;padding:9px;min-height:48px}
}
@media (prefers-reduced-motion:reduce){ *{animation-duration:.01ms !important;animation-iteration-count:1 !important} }

