/* đổi ngôn ngữ giữa trận: vẽ lại mọi cổng chưa húc */
function relabelGates(){
  gates.forEach(function(gt){
    if(!gt.active||gt.answered||!gt.raw) return;
    const it=window.resolveItem(gt.raw,langId);
    const wasLeftCorrect=gt.correctSide<0;
