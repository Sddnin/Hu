const gates=[];
function buildGate(){
  const g=new THREE.Group(); g.visible=false; scene.add(g);
  const halves=[];
  for(let s=-1;s<=1;s+=2){
    const half=new THREE.Group(); g.add(half);
    const px=s*(HALF*.52);
    const pillar=mk(G.box,M.pillar,s*(HALF+.6),2.6,0,1.1,5.2,1.1); pillar.castShadow=true; half.add(pillar);
    half.add(mk(G.sphere,M.gold,s*(HALF+.6),5.5,0,.55,.55,.55));
    const mat=new THREE.MeshStandardMaterial({map:boardTexture('—'),roughness:.6,emissive:0x101820,emissiveIntensity:.5});
    const board=mk(G.box,mat,px,4.1,0,HALF*.94,2.1,.28); board.castShadow=true; half.add(board);
    half.add(mk(G.box,M.gold,px,4.1,-.02,HALF*.98,2.24,.2));
    const bars=new THREE.Group(); half.add(bars);
    for(let i=0;i<7;i++){
      const bx=px-HALF*.42+i*(HALF*.84/6);
      bars.add(mk(G.cyl,M.bar,bx,1.5,0,.07,3,.07));
      bars.add(mk(G.cone,M.gold,bx,3.1,0,.13,.4,.13));
    }
    bars.add(mk(G.box,M.bar,px,2.5,0,HALF*.9,.12,.12));
    bars.add(mk(G.box,M.bar,px,.6,0,HALF*.9,.12,.12));
    halves.push({group:half,board:board,bars:bars,mat:mat,side:s});
  }
  const beam=mk(G.box,M.pillar,0,5.35,0,ROAD_W+2.4,.5,.7); g.add(beam);
  return {g:g,halves:halves,beam:beam,z:0,active:false,answered:false,correctSide:1,item:null,opts:null};
}
for(let i=0;i<4;i++) gates.push(buildGate());

function armGate(gt,z,rawItem){
  const it=window.resolveItem(rawItem,langId);
  const correctLeft=Math.random()<.5;
  const wrong=it.wrong[(Math.random()*it.wrong.length)|0]||it.answer;
  gt.item=it; gt.raw=rawItem; gt.z=z; gt.active=true; gt.answered=false;
  gt.correctSide=correctLeft?-1:1;
  gt.opts={left:correctLeft?it.answer:wrong,right:correctLeft?wrong:it.answer};
  gt.g.visible=true; gt.g.position.set(centerX(z),0,z); gt.g.rotation.y=Math.atan(slopeX(z));
  gt.beam.visible=true;
  gt.halves.forEach(function(h){
    h.group.position.set(0,0,0); h.group.rotation.set(0,0,0); h.group.visible=true;
    h.group.userData.fall=0; h.bars.visible=true;
    h.mat.map=boardTexture(h.side<0?gt.opts.left:gt.opts.right);
    h.mat.color.setHex(0xffffff); h.mat.emissive.setHex(0x101820); h.mat.needsUpdate=true;
  });
}
