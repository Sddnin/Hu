/* ========================================================= GATE RESOLVE */
function resolveGate(gt){
  gt.answered=true;
  const D=DIFF[diffKey], side=S.x<centerX(gt.z)?-1:1, ok=side===gt.correctSide;
  const chose=side<0?gt.opts.left:gt.opts.right;
  const hit=gt.halves[side<0?0:1], hx=centerX(gt.z)+side*(HALF*.52);
  S.log.push({k:gt.item.k,r:gt.item.r,answer:gt.item.answer,alt:gt.item.alt,ok:ok,chose:chose,latin:isLatinPrompt()});
  const pip=ui.pips.children[S.log.length-1]; if(pip) pip.className=ok?'on':'miss';
  hit.bars.visible=false; hit.group.userData.fall=1;
  throwDebris(hx,2.2,gt.z,ok?10:16,HALF*.4);
  if(ok){
    S.correct++; S.combo++; S.maxCombo=Math.max(S.maxCombo,S.combo);
    const mult=1+Math.min(S.combo-1,4)*.25, nitroBonus=S.nitroOn>0?60:0;
    const gain=Math.round(100*mult)+nitroBonus;
    S.score+=gain; S.time=Math.min(D.time+12,S.time+D.bonus); S.nitro=clamp(S.nitro+.22,0,1);
