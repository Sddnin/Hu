function mk(geo,mat,x,y,z,sx,sy,sz){
  const m=new THREE.Mesh(geo,mat);
  m.position.set(x||0,y||0,z||0);
  m.scale.set(sx===undefined?1:sx,sy===undefined?1:sy,sz===undefined?1:sz);
  return m;
}

/* ================================================================ TRACK */
const ROAD_W=15, HALF=ROAD_W/2, SEG=6, CHUNK=18, NCHUNK=26;
let curveAmp=1;
function centerX(z){ return (Math.sin(z*.0075)*11+Math.sin(z*.0031+1.7)*16)*curveAmp; }
function slopeX(z){ return (Math.cos(z*.0075)*.0075*11+Math.cos(z*.0031+1.7)*.0031*16)*curveAmp; }

const ground=mk(G.plane,M.grass,0,-.06,0,900,900,1);
ground.rotation.x=-Math.PI/2; ground.receiveShadow=true; scene.add(ground);

function buildChunk(){
  const g=new THREE.Group();
  const rg=new THREE.PlaneGeometry(ROAD_W,CHUNK,1,SEG); rg.rotateX(-Math.PI/2);
  const road=new THREE.Mesh(rg,M.road); road.receiveShadow=true; g.add(road);
  const kerbs=[];
  for(let s=-1;s<=1;s+=2){
    const kg=new THREE.PlaneGeometry(1.5,CHUNK,1,SEG); kg.rotateX(-Math.PI/2);
    const k=new THREE.Mesh(kg,M.kerb); k.position.y=.02; k.receiveShadow=true; g.add(k); kerbs.push(k);
  }
  const props=new THREE.Group(); g.add(props);
  scene.add(g);
  return {g:g,road:road,kerbs:kerbs,props:props,z:0};
}
const chunks=[]; for(let i=0;i<NCHUNK;i++) chunks.push(buildChunk());

function shapeChunk(ch){
  const pos=ch.road.geometry.attributes.position;
  for(let i=0;i<pos.count;i++) pos.setX(i,pos.getX(i)*0+baseRoadX(ch.road,i)+centerX(ch.z+pos.getZ(i))-centerX(ch.z));
  pos.needsUpdate=true; ch.road.geometry.computeVertexNormals();
  ch.kerbs.forEach(function(k,s){
    const p=k.geometry.attributes.position, side=s===0?-1:1;
    for(let i=0;i<p.count;i++) p.setX(i,baseKerbX(k,i)+side*(HALF+.75)+centerX(ch.z+p.getZ(i))-centerX(ch.z));
    p.needsUpdate=true; k.geometry.computeVertexNormals();
  });
}
/* lưu toạ độ gốc để không bị trôi khi reshape nhiều lần */
function stashBase(mesh,key){ mesh.userData[key]=mesh.geometry.attributes.position.array.slice(); }
chunks.forEach(function(ch){ stashBase(ch.road,'bx'); ch.kerbs.forEach(function(k){ stashBase(k,'bx'); }); });
function baseRoadX(mesh,i){ return mesh.userData.bx[i*3]; }
function baseKerbX(mesh,i){ return mesh.userData.bx[i*3]; }

function tree(x,z){
  const g=new THREE.Group();
  g.add(mk(G.cyl,M.trunk,0,1.1,0,.32,2.2,.32));
  if(Math.random()<.5){
    g.add(mk(G.cone,M.leafA,0,3.4,0,1.9,3.4,1.9));
    g.add(mk(G.cone,M.leafB,0,5.1,0,1.35,2.6,1.35));
  }else{
    g.add(mk(G.box,M.leafB,0,3.3,0,2.9,2.6,2.9));
    g.add(mk(G.box,M.leafA,.5,4.7,.3,1.9,1.7,1.9));
  }
  g.position.set(x,0,z); g.rotation.y=rand(0,6.28);
  g.traverse(function(o){ if(o.isMesh) o.castShadow=true; });
  return g;
}
function house(x,z){
  const g=new THREE.Group(), w=rand(5,8), h=rand(4,7), d=rand(5,8);
  const body=mk(G.box,M.wall,0,h/2,0,w,h,d); body.castShadow=true; g.add(body);
  const roof=mk(G.cone,Math.random()<.5?M.roof:M.roof2,0,h+1.5,0,Math.max(w,d)*.82,3,Math.max(w,d)*.82);
  roof.rotation.y=Math.PI/4; roof.castShadow=true; g.add(roof);
  for(let i=-1;i<=1;i+=2) g.add(mk(G.box,M.win,i*w*.24,h*.55,d/2+.03,1.3,1.5,.1));
  g.add(mk(G.box,M.dark,0,1.1,d/2+.03,1.4,2.2,.12));
  g.position.set(x,0,z); g.rotation.y=rand(-.4,.4);
  return g;
}
function lamp(x,z){
  const g=new THREE.Group();
  g.add(mk(G.cyl,M.pole,0,3.4,0,.16,6.8,.16));
  g.add(mk(G.box,M.pole,x>0?-1:1,6.7,0,2.2,.18,.18));
  g.add(mk(G.box,M.lamp,x>0?-2:2,6.55,0,.9,.22,.5));
  g.position.set(x,0,z); return g;
}
function decorate(ch){
  while(ch.props.children.length) ch.props.remove(ch.props.children[0]);
  const n=5+((Math.random()*4)|0);
  for(let i=0;i<n;i++){
    const side=Math.random()<.5?-1:1, lz=rand(-CHUNK/2,CHUNK/2);
    const off=centerX(ch.z+lz)-centerX(ch.z), r=Math.random();
    let p;
    if(r<.62) p=tree(off+side*rand(HALF+3,HALF+26),lz);
    else if(r<.86) p=house(off+side*rand(HALF+11,HALF+24),lz);
    else p=lamp(off+side*(HALF+2.4),lz);
    ch.props.add(p);
  }
}
function placeChunk(ch,z){ ch.z=z; ch.g.position.z=z; shapeChunk(ch); decorate(ch); }
function resetTrack(){ for(let i=0;i<NCHUNK;i++) placeChunk(chunks[i],(i-3)*CHUNK); }
function recycleTrack(z){
  for(let i=0;i<chunks.length;i++){
    const ch=chunks[i];
    if(ch.z<z-CHUNK*3.2){
      let maxZ=-1e9; for(let j=0;j<chunks.length;j++) maxZ=Math.max(maxZ,chunks[j].z);
      placeChunk(ch,maxZ+CHUNK);
    }
  }
}

/* ================================================================= TANK */
const tank=new THREE.Group(); scene.add(tank);
const hull=new THREE.Group(); tank.add(hull);
(function(){
  const lower=mk(G.box,M.dark,0,.62,0,3.1,.7,4.9); lower.castShadow=true; hull.add(lower);
  const upper=mk(G.box,M.body,0,1.22,0,2.8,.75,4.4); upper.castShadow=true; hull.add(upper);
  const nose=mk(G.box,M.body,0,1.05,2.35,2.6,.6,.9); nose.rotation.x=-.32; nose.castShadow=true; hull.add(nose);
  for(let s=-1;s<=1;s+=2){
    const tr=mk(G.box,M.track,s*1.62,.62,0,.72,1.05,5.2); tr.castShadow=true; hull.add(tr);
    for(let i=-2;i<=2;i++){ const w=mk(G.cyl,M.metal,s*1.62,.6,i*1.05,.44,.8,.44); w.rotation.z=Math.PI/2; hull.add(w); }
    hull.add(mk(G.box,M.body,s*1.62,1.2,0,.8,.28,5.0));
    const n=mk(G.plane,M.num,s*2.03,1.25,-.2,1.5,.75,1); n.rotation.y=s*Math.PI/2; hull.add(n);
    hull.add(mk(G.box,M.hazard,s*1.0,1.35,-2.45,.35,.22,.12));
