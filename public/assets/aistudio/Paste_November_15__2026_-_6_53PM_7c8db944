/* ============================================================================
   words.js — NGÂN HÀNG TỪ VỰNG ĐA NGÔN NGỮ
   ----------------------------------------------------------------------------
   Mỗi item:
     k : từ hiện trên thẻ câu hỏi      r : phiên âm / IPA      t : loại từ
     v : nghĩa TIẾNG VIỆT              e : nghĩa TIẾNG ANH
     d : 2 đáp án nhiễu tiếng Việt     de: 2 đáp án nhiễu tiếng Anh
   ► Mặc định tiếng Anh: game.js → CONFIG.deck='english', CONFIG.lang='en'
   ► Thêm bộ từ mới: thêm 1 object vào DECKS với đủ các trường trên.
   ========================================================================== */
(function(){
'use strict';

window.LANGS={ vi:{id:'vi',label:'Tiếng Việt',short:'VI'}, en:{id:'en',label:'English',short:'EN'} };

window.DECKS=[
{
  id:'korean', label:'한국어 · Tiếng Hàn', short:'KO', promptFont:'ko',
  note:'40 từ sơ cấp thông dụng',
  items:[
