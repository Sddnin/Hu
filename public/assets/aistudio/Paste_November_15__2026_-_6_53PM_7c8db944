/* ============================================================= TEXTURES */
function cv(w,h){ const c=document.createElement('canvas'); c.width=w;c.height=h; return c; }
function tex(c,rx,ry){
  const t=new THREE.CanvasTexture(c);
  t.anisotropy=Math.min(4,renderer.capabilities.getMaxAnisotropy());
  if(rx){ t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(rx,ry||1); }
  t.encoding=THREE.sRGBEncoding; return t;
}
const roadTex=(function(){
  const c=cv(128,256),x=c.getContext('2d');
  x.fillStyle='#3b4048'; x.fillRect(0,0,128,256);
  for(let i=0;i<2200;i++){ const g=(Math.random()*40)|0;
    x.fillStyle='rgba('+(120+g)+','+(124+g)+','+(132+g)+','+(Math.random()*.16)+')';
    x.fillRect(Math.random()*128,Math.random()*256,2,2); }
  for(let i=0;i<150;i++){ x.fillStyle='rgba(190,40,40,'+(Math.random()*.1)+')'; x.fillRect(Math.random()*128,Math.random()*256,3,2); }
  x.fillStyle='#ffd84d'; x.fillRect(60,26,8,110); x.fillRect(60,166,8,70);
  x.fillStyle='rgba(255,255,255,.5)'; x.fillRect(3,0,3,256); x.fillRect(122,0,3,256);
  return tex(c,1,1);
})();
const kerbTex=(function(){ const c=cv(16,64),x=c.getContext('2d');
  x.fillStyle='#f2f4f7'; x.fillRect(0,0,16,64); x.fillStyle='#e8232f'; x.fillRect(0,0,16,32); return tex(c,1,1); })();
const grassTex=(function(){ const c=cv(64,64),x=c.getContext('2d');
  x.fillStyle='#5aa03a'; x.fillRect(0,0,64,64);
  for(let i=0;i<800;i++){ x.fillStyle='rgba('+((60+Math.random()*50)|0)+','+((140+Math.random()*60)|0)+',60,.35)';
    x.fillRect(Math.random()*64,Math.random()*64,2,3); }
  return tex(c,30,30); })();
const flagTex=(function(){ const c=cv(120,80),x=c.getContext('2d');
  x.fillStyle='#da251d'; x.fillRect(0,0,120,80); x.fillStyle='#ffff00'; x.beginPath();
  for(let i=0;i<10;i++){ const a=-Math.PI/2+i*Math.PI/5, r=(i%2===0)?22:8.4;
    const px=60+Math.cos(a)*r, py=40+Math.sin(a)*r; i?x.lineTo(px,py):x.moveTo(px,py); }
  x.closePath(); x.fill(); return tex(c); })();
const dotTex=(function(){ const c=cv(64,64),x=c.getContext('2d');
  const g=x.createRadialGradient(32,32,0,32,32,32);
  g.addColorStop(0,'rgba(255,255,255,1)'); g.addColorStop(.35,'rgba(255,255,255,.6)'); g.addColorStop(1,'rgba(255,255,255,0)');
  x.fillStyle=g; x.fillRect(0,0,64,64); return new THREE.CanvasTexture(c); })();
const numTex=(function(){ const c=cv(128,64),x=c.getContext('2d');
  x.font='800 46px "Be Vietnam Pro",system-ui,sans-serif'; x.textAlign='center'; x.textBaseline='middle';
  x.fillStyle='#f4efe2'; x.fillText('390',64,34); return new THREE.CanvasTexture(c); })();

const boardCache=new Map();
function boardTexture(text){
  if(boardCache.has(text)) return boardCache.get(text);
  const W=512,H=170,c=cv(W,H),x=c.getContext('2d');
  const g=x.createLinearGradient(0,0,0,H); g.addColorStop(0,'#16273c'); g.addColorStop(1,'#060b12');
  x.fillStyle=g; x.fillRect(0,0,W,H);
  x.strokeStyle='#ffc21f'; x.lineWidth=10; x.strokeRect(5,5,W-10,H-10);
  x.strokeStyle='rgba(255,255,255,.13)'; x.lineWidth=2; x.strokeRect(19,19,W-38,H-38);
  x.textAlign='center'; x.textBaseline='middle';
  const setF=function(s){ x.font='800 '+s+'px "Be Vietnam Pro",system-ui,sans-serif'; };
  setF(60);
  let lines=[String(text)];
  if(x.measureText(text).width>W-80){
    const words=String(text).split(' ');
    if(words.length>1){
      let best=1,bestDiff=1e9;
      for(let i=1;i<words.length;i++){
        const d=Math.abs(words.slice(0,i).join(' ').length-words.slice(i).join(' ').length);
        if(d<bestDiff){ bestDiff=d; best=i; }
      }
      lines=[words.slice(0,best).join(' '),words.slice(best).join(' ')];
    }
  }
  let size=lines.length>1?52:62; setF(size);
  let widest=Math.max.apply(null,lines.map(function(l){ return x.measureText(l).width; }));
  while(widest>W-72&&size>16){ size-=2; setF(size); widest=Math.max.apply(null,lines.map(function(l){ return x.measureText(l).width; })); }
  const lh=size*1.14, y0=H/2-(lines.length-1)*lh/2;
  lines.forEach(function(l,i){
    x.fillStyle='rgba(0,0,0,.55)'; x.fillText(l,W/2+3,y0+i*lh+4);
    x.fillStyle='#f7f3e6'; x.fillText(l,W/2,y0+i*lh);
  });
  const t=tex(c); boardCache.set(text,t);
  if(boardCache.size>150){ const k=boardCache.keys().next().value; boardCache.get(k).dispose(); boardCache.delete(k); }
  return t;
}

/* ======================================================= SHARED GEO/MAT */
const G={ box:new THREE.BoxGeometry(1,1,1), cyl:new THREE.CylinderGeometry(1,1,1,12),
  cone:new THREE.ConeGeometry(1,1,8), sphere:new THREE.SphereGeometry(1,12,10), plane:new THREE.PlaneGeometry(1,1),
  oct:new THREE.OctahedronGeometry(1,0) };
const M={
  road:new THREE.MeshStandardMaterial({map:roadTex,roughness:.94}),
  kerb:new THREE.MeshStandardMaterial({map:kerbTex,roughness:.7}),
  grass:new THREE.MeshStandardMaterial({map:grassTex,roughness:1}),
  body:new THREE.MeshStandardMaterial({color:0x4f7a2e,roughness:.72,metalness:.22,flatShading:true}),
  dark:new THREE.MeshStandardMaterial({color:0x35521f,roughness:.8,flatShading:true}),
  track:new THREE.MeshStandardMaterial({color:0x1d2418,roughness:.95,flatShading:true}),
  metal:new THREE.MeshStandardMaterial({color:0x39432c,roughness:.5,metalness:.6,flatShading:true}),
  trunk:new THREE.MeshStandardMaterial({color:0x7a5230,roughness:1,flatShading:true}),
  leafA:new THREE.MeshStandardMaterial({color:0x2f8f3e,roughness:.95,flatShading:true}),
  leafB:new THREE.MeshStandardMaterial({color:0x49b04a,roughness:.95,flatShading:true}),
  wall:new THREE.MeshStandardMaterial({color:0xeef2f5,roughness:.9,flatShading:true}),
  roof:new THREE.MeshStandardMaterial({color:0x35c07a,roughness:.8,flatShading:true}),
  roof2:new THREE.MeshStandardMaterial({color:0x2f7dff,roughness:.8,flatShading:true}),
  win:new THREE.MeshStandardMaterial({color:0x1d3550,roughness:.3,metalness:.4,emissive:0x0d2038,emissiveIntensity:.6}),
  pole:new THREE.MeshStandardMaterial({color:0xd7dee6,roughness:.5,metalness:.4}),
  lamp:new THREE.MeshStandardMaterial({color:0xfff3c4,emissive:0xffc21f,emissiveIntensity:1.1}),
  pillar:new THREE.MeshStandardMaterial({color:0xf1ece0,roughness:.85,flatShading:true}),
  gold:new THREE.MeshStandardMaterial({color:0xffc21f,roughness:.28,metalness:.85,emissive:0x4a3200,emissiveIntensity:.5}),
  bar:new THREE.MeshStandardMaterial({color:0x1a1f26,roughness:.6,metalness:.6}),
  hazard:new THREE.MeshStandardMaterial({color:0xffc21f,roughness:.7,emissive:0x3a2a00,emissiveIntensity:.6}),
