{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user study preferences and daily goals without PII.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Short display label."
        },
        "dailyGoal": {
          "type": "integer",
          "description": "Target cards per day (5 to 200)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["ownerId", "displayName", "dailyGoal", "createdAt", "updatedAt"]
    },
    "Deck": {
      "title": "Deck",
      "description": "A flashcard vocabulary deck belonging to a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "cardCount": {
          "type": "integer"
        },
        "masteredCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "description", "category", "cardCount", "masteredCount", "createdAt", "updatedAt"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "An individual vocabulary flashcard inside a deck.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deckId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phonetic": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "partOfSpeech": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "example": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350
        },
        "mastery": {
          "type": "string",
          "enum": ["new", "learning", "mastered"]
        },
        "reviewCount": {
          "type": "integer"
        },
        "correctCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "deckId", "ownerId", "term", "phonetic", "partOfSpeech", "meaning", "example", "mastery", "reviewCount", "correctCount", "createdAt", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Immutable record of a completed practice session for progress tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deckId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deckTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "mode": {
          "type": "string",
          "enum": ["flip", "quiz", "fill", "match"]
        },
        "totalItems": {
          "type": "integer"
        },
        "correctCount": {
          "type": "integer"
        },
        "accuracy": {
          "type": "integer"
        },
        "durationSeconds": {
          "type": "integer"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "deckId", "deckTitle", "mode", "totalItems", "correctCount", "accuracy", "durationSeconds", "dateKey", "completedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User preferences profile document owned strictly by userId."
    },
    "/users/{userId}/decks/{deckId}": {
      "schema": { "$ref": "#/entities/Deck" },
      "description": "User's flashcard decks."
    },
    "/users/{userId}/decks/{deckId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/Flashcard" },
      "description": "Vocabulary flashcards within a user's deck."
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Completed practice sessions for progress history and analytics."
    }
  }
}
