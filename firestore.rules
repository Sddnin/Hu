rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'dailyGoal', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'dailyGoal', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.dailyGoal is int && data.dailyGoal >= 5 && data.dailyGoal <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeck(data, deckId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'description', 'category', 'cardCount', 'masteredCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'description', 'category', 'cardCount', 'masteredCount', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == deckId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 300
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 50
        && data.cardCount is int && data.cardCount >= 0 && data.cardCount <= 2000
        && data.masteredCount is int && data.masteredCount >= 0 && data.masteredCount <= data.cardCount
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFlashcard(data, cardId, deckId, userId) {
      return data.keys().hasAll(['id', 'deckId', 'ownerId', 'term', 'phonetic', 'partOfSpeech', 'meaning', 'example', 'mastery', 'reviewCount', 'correctCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'deckId', 'ownerId', 'term', 'phonetic', 'partOfSpeech', 'meaning', 'example', 'mastery', 'reviewCount', 'correctCount', 'starred', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == cardId && isValidId(data.id)
        && data.deckId is string && data.deckId == deckId && isValidId(data.deckId)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.term is string && data.term.size() >= 1 && data.term.size() <= 120
        && data.phonetic is string && data.phonetic.size() <= 80
        && data.partOfSpeech is string && data.partOfSpeech.size() <= 40
        && data.meaning is string && data.meaning.size() >= 1 && data.meaning.size() <= 240
        && data.example is string && data.example.size() <= 350
        && data.mastery in ['new', 'learning', 'mastered']
        && data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 100000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.reviewCount
        && (!('starred' in data) || data.starred is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudySession(data, sessionId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'deckId', 'deckTitle', 'mode', 'totalItems', 'correctCount', 'accuracy', 'durationSeconds', 'dateKey', 'completedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'deckId', 'deckTitle', 'mode', 'totalItems', 'correctCount', 'accuracy', 'durationSeconds', 'dateKey', 'completedAt'])
        && data.id is string && data.id == sessionId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.deckId is string && isValidId(data.deckId)
        && data.deckTitle is string && data.deckTitle.size() >= 1 && data.deckTitle.size() <= 100
        && data.mode in ['flip', 'learn', 'quiz', 'fill', 'match', 'spell', 'test']
        && data.totalItems is int && data.totalItems >= 1 && data.totalItems <= 500
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.totalItems
        && data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 100
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.completedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'dailyGoal', 'updatedAt']);
      allow delete: if false;

      match /decks/{deckId} {
        allow get: if isValidId(userId) && isValidId(deckId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(deckId)
          && isOwner(userId)
          && isValidDeck(incoming(), deckId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(deckId)
          && isOwner(userId)
          && isValidDeck(incoming(), deckId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['cardCount', 'masteredCount', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(deckId) && isOwner(userId);

        match /cards/{cardId} {
          allow get: if isValidId(userId) && isValidId(deckId) && isValidId(cardId) && isOwner(userId);
          allow list: if isValidId(userId) && isValidId(deckId) && isOwner(userId) && existing().ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(deckId) && isValidId(cardId)
            && isOwner(userId)
            && isValidFlashcard(incoming(), cardId, deckId, userId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && existsAfter(/databases/$(database)/documents/users/$(userId)/decks/$(deckId))
            && getAfter(/databases/$(database)/documents/users/$(userId)/decks/$(deckId)).data.ownerId == request.auth.uid;
          allow update: if isValidId(userId) && isValidId(deckId) && isValidId(cardId)
            && isOwner(userId)
            && isValidFlashcard(incoming(), cardId, deckId, userId)
            && incoming().id == existing().id
            && incoming().deckId == existing().deckId
            && incoming().ownerId == existing().ownerId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['term', 'phonetic', 'partOfSpeech', 'meaning', 'example', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['mastery', 'reviewCount', 'correctCount', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['starred', 'updatedAt'])
            );
          allow delete: if isValidId(userId) && isValidId(deckId) && isValidId(cardId) && isOwner(userId);
        }
      }

      match /studySessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(sessionId)
          && isOwner(userId)
          && isValidStudySession(incoming(), sessionId, userId)
          && incoming().completedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }
    }
  }
}
